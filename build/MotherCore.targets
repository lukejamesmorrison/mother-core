<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    Post-pack optimization of the packaged script, shared by every project that imports MotherCore.projitems.
    Runs after MDK packs the script and before an extension's own post-pack target (MinifyScriptFile), so
    whatever that target copies or publishes is already optimized. The optimizer compiles the script with the
    project's references, so it can use `var` for locals, alias long collection types (Dictionary<string,object>
    and similar) with one-character subclasses, drop `public` from members only used by their own type, and
    remove line breaks. Each pass is checked by recompiling, and a pass that breaks the script is skipped.

    Properties (all optional):
      MotherCoreOptimize    Set to false to skip the optimizer.
      MotherCoreScriptPath  The packaged script. Defaults to the MDK output for the project.
  -->

  <Target Name="MotherCoreOptimizeScript" AfterTargets="MdkPack" BeforeTargets="MinifyScriptFile" Condition="'$(MotherCoreOptimize)' != 'false'">
    <PropertyGroup>
      <_MotherCoreScript>$(MotherCoreScriptPath)</_MotherCoreScript>
      <_MotherCoreScript Condition="'$(_MotherCoreScript)' == ''">$(SpaceEngineersDataPath)\IngameScripts\local\$(MSBuildProjectName)\script.cs</_MotherCoreScript>
      <_MotherCoreReferences>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'motherCore-script-optimizer.refs'))</_MotherCoreReferences>
      <_MotherCoreOptimizer>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'ScriptOptimizer'))</_MotherCoreOptimizer>
    </PropertyGroup>

    <WriteLinesToFile File="$(_MotherCoreReferences)" Lines="@(ReferencePath)" Overwrite="true" />

    <!-- Leaves the script untouched if the optimizer cannot run or finds a problem, so the build still succeeds. -->
    <Exec Command="dotnet run --project &quot;$(_MotherCoreOptimizer)&quot; -c Release -- &quot;$(_MotherCoreScript)&quot; &quot;$(_MotherCoreReferences)&quot;" ContinueOnError="true" />
  </Target>

  <!--
    Removes keywords ('private', 'readonly', and 'public' on top-level types) from the packaged script.
    Runs after the optimizer and before an extension's own post-pack target (MinifyScriptFile). The script is
    idempotent, so a project's own .build\RemoveKeywords.ps1 can still run afterwards without harm.

    Properties (all optional):
      MotherCoreRemoveKeywords  Set to false to skip keyword removal.
  -->

  <Target Name="MotherCoreRemoveKeywords" AfterTargets="MdkPack;MotherCoreOptimizeScript" BeforeTargets="MinifyScriptFile" Condition="'$(MotherCoreRemoveKeywords)' != 'false'">
    <PropertyGroup>
      <_MotherCoreKeywordScript>$(MotherCoreScriptPath)</_MotherCoreKeywordScript>
      <_MotherCoreKeywordScript Condition="'$(_MotherCoreKeywordScript)' == ''">$(SpaceEngineersDataPath)\IngameScripts\local\$(MSBuildProjectName)\script.cs</_MotherCoreKeywordScript>
      <_MotherCoreKeywordTool>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'RemoveKeywords.ps1'))</_MotherCoreKeywordTool>
    </PropertyGroup>

    <Exec Command="powershell -ExecutionPolicy Bypass -NoProfile -File &quot;$(_MotherCoreKeywordTool)&quot; &quot;$(_MotherCoreKeywordScript)&quot;" ContinueOnError="true" />
  </Target>

</Project>
